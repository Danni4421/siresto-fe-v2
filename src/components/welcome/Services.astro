---
import deliveryIcon from "../../assets/services/delivery.png"
import takeawayIcon from "../../assets/services/takeaway.png"
import dineInIcon from "../../assets/services/dine-in.png"

interface Service {
    icon: string;
    label: string;
}

const services: Service[] = [
    {
        icon: deliveryIcon.src,
        label: "Delivery",
    },
    {
        icon: takeawayIcon.src,
        label: "Takeaway",
    },
    {
        icon: dineInIcon.src,
        label: "Dine in",
    }
]
---

<section>
    <div class="text-center max-w-lg mx-auto">
        <h5 class="text-xl font-medium text-[#FF4C00]">Our Services</h5>
        <h3 class="text-2xl font-semibold">Layanan Kami</h3>
        <p class="font-light mt-2">Kami menyediakan berbagai layanan terbaik untuk memenuhi kebutuhan Anda.</p>
    </div>

   <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-7xl mx-auto mt-8 px-4">
    {services.map((service) => (
        <div class="flex items-center gap-4 border border-gray-100 rounded-lg p-4">
            <img src={service.icon} alt={service.label} class="w-8 h-8 rounded-lg" />
            {service.label}
        </div>
    ))}
   </div>
</section>  