---
import { ShoppingCart } from "@lucide/astro"
import SearchBar from "./SearchBar.tsx"
---

<nav class="sticky top-0 left-0 z-50 min-w-screen bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 md:px-0">
        <div class="flex justify-between h-16 items-center">
            <div class="flex items-center gap-8">
                <h1 class="text-xl font-bold text-gray-800">
                    SiResto
                </h1>
    
                <ul class="space-x-8 hidden md:flex">
                    <li>
                        <a href="/" class="text-gray-600 hover:text-gray-900 transition-colors duration-200">Daftar Menu</a>
                    </li>
                    <li>
                        <a href="/test" class="text-gray-600 hover:text-gray-900 transition-colors duration-200">Layanan</a>
                    </li>
                    <li>
                        <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors duration-200">Contact</a>
                    </li>
                    <li>
                        <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors duration-200">About Us</a>
                    </li>
                </ul>
            </div>

            <div class="flex items-center gap-6">
                <SearchBar client:visible/>
                <button class="cursor-pointer hover:scale-105 transition-transform">
                    <ShoppingCart />
                </button>
            </div>
        </div>
    </div>
</nav>